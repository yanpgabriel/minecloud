# Copie pra .env (nao commitado) e ajuste conforme o caso.

# Endereco do registry Docker usado por `make publish` / `just publish`
# e pelo `image:` do docker-compose.yml.
#
# Padrao: DNS publico do Gitea.
REGISTRY_IMAGE=gitea.oyan.dev/yan/minecloud
#
# Alternativa: IP/porta local, pra contornar o limite de upload de 100MB
# da Cloudflare (a camada do JDK sozinha tem 365MB) quando publicando de
# dentro da mesma rede do Gitea.
# REGISTRY_IMAGE=X.X.X.X:3000/yan/minecloud

# UID/GID que o processo roda dentro do container, em runtime (nao precisa
# rebuildar a imagem pra mudar). Padrao 1000:1000, igual ao build da imagem.
# Ajuste pra bater com o dono de ./minecraft no host, ex: se a pasta
# pertence a um usuario com uid/gid 1001, sobe HOST_UID=1001 HOST_GID=1001
# em vez de dar chown na pasta.
# HOST_UID=1000
# HOST_GID=1000
